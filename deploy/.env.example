# Salin ke deploy/.env (gitignored) dan isi nilai ASLI. Ini ENV RUNTIME server
# (di-source oleh deploy.sh → PM2 env_production). Variabel NEXT_PUBLIC_* TIDAK di
# sini — itu di-bake saat build dari .env/.env.local lokal.
# Generate secret kuat: openssl rand -hex 32

# --- Database MySQL 8 di server (localhost) ----------------------------------
# Server memakai MySQL 8 (MariaDB sudah di-purge; data lamanya diarsipkan di
# /var/lib/mysql-MARIADB-BACKUP + dump di /root/backup-final/).
# Engine lokal & server sama-sama MySQL 8 → dump/impor tanpa konversi.
# Buat user sekali di server:
#   mysql -e "CREATE USER 'daga'@'localhost' IDENTIFIED BY 'ISI_PASSWORD';
#             GRANT ALL ON \`daga\`.* TO 'daga'@'localhost'; FLUSH PRIVILEGES;"
DB_NAME=daga
DB_USER=daga
DB_PASSWORD=__ISI_PASSWORD_DB_KUAT__
DATABASE_URL="mysql://daga:__ISI_PASSWORD_DB_KUAT__@127.0.0.1:3306/daga"

# --- Sesi / login (WAJIB, >= 32 char acak) -----------------------------------
AUTH_SECRET=__ISI_STRING_ACAK_MINIMAL_32_KARAKTER__

# --- URL publik app (untuk metadata / email) ---------------------------------
# DAGA memegang domain utama (Laravel lama dimatikan saat --cutover).
APP_URL=https://disdukcapil.tidorekota.go.id
NEXT_PUBLIC_APP_URL=https://disdukcapil.tidorekota.go.id

# --- reCAPTCHA v3 (secret; site key sudah di-bake saat build) ----------------
RECAPTCHA_V3_SECRET_KEY=__ISI_SECRET_KEY__

# --- Email (opsional; untuk reset password dll) ------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=__ISI__@gmail.com
MAIL_PASS=__APP_PASSWORD__
MAIL_FROM="DAGA Disdukcapil Kota Tidore Kepulauan <no-reply@tidorekota.go.id>"

# --- OTP WhatsApp via Fonnte -------------------------------------------------
# Token DEVICE dari dashboard Fonnte (Device → Token), bukan token akun.
# Kosong di production = OTP DILEWATI (register tanpa verifikasi WA).
FONNTE_TOKEN=__ISI_TOKEN_DEVICE_FONNTE__

# --- Halaman Master (buka kunci permohonan final) ----------------------------
# Kosong = /dashboard/master dinonaktifkan (503).
MASTER_PASSWORD=__ISI_PASSWORD_MASTER__

# --- Port app (internal; publik lewat Apache reverse proxy) ------------------
PORT=3001

# Selama uji via HTTP (SSL asli belum terbit) cookie sesi tidak boleh Secure.
# SETELAH certbot aktif → HAPUS baris ini agar cookie kembali Secure, lalu deploy ulang.
AUTH_COOKIE_SECURE=false
