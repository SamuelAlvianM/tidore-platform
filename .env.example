# =============================================================================
# tidore-platform (DAGA) — Environment Variables
# Disdukcapil Kota Tidore Kepulauan — hasil migrasi Laravel -> Next.js
# Aturan: variabel yang dipakai di browser HARUS diawali NEXT_PUBLIC_
# Variabel rahasia (secret/password) TANPA NEXT_PUBLIC_ -> hanya server-side
# =============================================================================

# --- Database (MySQL) — full-stack Next.js + Prisma --------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/tidore"

# --- Rahasia sesi (JWT login) — WAJIB diisi string acak >= 32 karakter -------
AUTH_SECRET="__ISI_STRING_ACAK_MINIMAL_32_KARAKTER__"

# Base URL untuk client memanggil API sendiri (kosong = relatif, disarankan).
NEXT_PUBLIC_API_URL=

# --- Identitas Situs (publik) ------------------------------------------------
NEXT_PUBLIC_APP_NAME="disdukcapil kota tidore kepulauan - daga"
NEXT_PUBLIC_APP_URL=https://disdukcapil.tidorekota.go.id
NEXT_PUBLIC_APP_KODE=8272

NEXT_PUBLIC_SITE_TENANT=disdukcapil
NEXT_PUBLIC_SITE_TENANT2="dinas dukcapil"
NEXT_PUBLIC_SITE_NAME_FULLNAME="tidore kepulauan"
NEXT_PUBLIC_SITE_NAME_NICKNAME=tidore
NEXT_PUBLIC_SITE_NAME_FAMOUS=daga
NEXT_PUBLIC_SITE_NAME_KET=pelayanan
NEXT_PUBLIC_SITE_NAVBAR_BGCOLOR="rgb(255 204 0 / 70%)"
NEXT_PUBLIC_SITE_NAVBAR_TEXTSHADOW="1px 1px 30px #fff"
NEXT_PUBLIC_SITE_VERSION=26.07.30.001
NEXT_PUBLIC_SITE_COPYRIGHT_YEAR=2026
NEXT_PUBLIC_SITE_POWEREDBY="ga tech"

# --- Antrian loket (APLIKASI TERPISAH) ---------------------------------------
# Menu navbar "Antrian" hanyalah PINTU ke aplikasi antrian-dukcapil yang berdiri
# sendiri (pm2 `antrian`, 127.0.0.1:3000, PostgreSQL sendiri). Portal ini tidak
# memuat kodenya.
#
# Produksi: biarkan `/antrian` — Apache yang meneruskan path itu ke :3000
# (blok proxy ada di deploy/apache-daga.conf).
#
# ⚠️ Nilainya DI-BAKE SAAT `next build` di laptop. Jangan menaruh alamat
# localhost di .env / .env.local, karena ikut terbawa ke produksi. Untuk uji di
# laptop pakai .env.development.local — berkas itu TIDAK dibaca saat build.
NEXT_PUBLIC_ANTRIAN_URL=/antrian

# --- Maps & Relasi (publik) --------------------------------------------------
NEXT_PUBLIC_SITE_MAPS_ALAMAT_EMBED="https://maps.google.com/maps?q=dinas%20dukcapil%20kota%20tidore%20kepulauan&t=&z=13&ie=UTF8&iwloc=&output=embed"
NEXT_PUBLIC_SITE_MAPS_ALAMAT_KET="Dinas Kependudukan dan Pencatatan Sipil Kota Tidore Kepulauan: Jl. Ahmad Yani No.A, Indonesiana, Tidore, Kota Tidore Kepulauan, Maluku Utara"
NEXT_PUBLIC_SITE_MAPS_GIS_JSON=maps_tidore
NEXT_PUBLIC_SITE_RELASI_LPSE=http://lpse.tidorekota.go.id
NEXT_PUBLIC_SITE_RELASI_DINAS=https://tidorekota.go.id

# --- Analytics (publik) ------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-VK46H4RTT7
NEXT_PUBLIC_GOOGLE_TAGMANAGER_ID=GTM-PS2B6DG
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION_ID=gmJxZ19ZSYS7KZIttKg-OIgDHGBiIMhjdCwmLZub35U

# --- Database (HANYA jika Next.js akan akses DB langsung; default: lewat backend) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=ktt_db
# DB_USERNAME=ktt_user
# DB_PASSWORD=__ISI_DENGAN_PASSWORD__

# --- Mail (server-side, jika kirim email dari Next.js) -----------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tidore.disdukcapil@gmail.com
# MAIL_PASSWORD=__ISI_DENGAN_APP_PASSWORD__
# MAIL_ENCRYPTION=tls

# --- OTP WhatsApp via Fonnte (https://fonnte.com) ----------------------------
# Token DEVICE dari dashboard Fonnte (Devices -> device tersambung -> Token).
# Tanpa token: dev = kode OTP tampil di layar; production = OTP dilewati.
# FONNTE_TOKEN=__ISI_DENGAN_DEVICE_TOKEN__

# --- Halaman Master (buka kunci permohonan final) ----------------------------
# Password akses tertinggi di /dashboard/master. GANTI di production!
# MASTER_PASSWORD=__ISI_DENGAN_PASSWORD_MASTER__
